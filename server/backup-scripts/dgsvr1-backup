#!/bin/bash
# Pull a snapshot of dgsvr1 onto the drive labeled "dgsvr1-backup".
# Run this on the laptop. The Samsung drive stays plugged into the laptop.
# The server files cross the home network with rsync over SSH.
#
#   full  Complete copy of the system disk, EFI, /data, and /data2.
#         After it succeeds, older snapshots are removed.
#   incr  Complete restorable copy. Unchanged files are reused from the
#         newest snapshot, so the extra space is only what changed.
#
# The finished snapshot matches what dgsvr1-restore already expects:
#   dgsvr1-snapshots/<name>/{root,efi,data,data2}
#   dgsvr1-snapshots/.complete-<name>
set -u

MODE="${1:-}"
if [[ "$MODE" != "full" && "$MODE" != "incr" ]]; then
  echo "Usage: dgsvr1-backup full|incr" >&2
  exit 2
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Must run as root." >&2
  exit 1
fi

if [[ -z "${DGS_BACKUP_INHIBIT:-}" ]] && command -v systemd-inhibit >/dev/null 2>&1; then
  export DGS_BACKUP_INHIBIT=1
  exec systemd-inhibit --what=sleep:idle:handle-lid-switch \
    --who=dgsvr1-backup \
    --why="Copying dgsvr1 onto the Samsung drive" \
    "$0" "$@"
fi

SERVER="dgsvr1"
SSH_USER="root"
SSH_KEY="/root/.ssh/dgsvr1-backup"
KNOWN_HOSTS="/root/.ssh/dgsvr1-backup.known_hosts"
CONF="/etc/dgsvr1-backup.conf"
if [[ -f "$CONF" ]]; then
  conf_owner=$(stat -c '%u' "$CONF")
  conf_mode=$(stat -c '%a' "$CONF")
  if [[ "$conf_owner" != "0" ]] || (( (8#$conf_mode & 8#022) != 0 )); then
    echo "$CONF must be owned by root and not writable by group or others." >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source "$CONF"
fi

MNT="/mnt/dgsvr1-backup"
SNAPDIR="dgsvr1-snapshots"
BACKUP_LABEL="dgsvr1-backup"
REPORT_DIR="/srv/maintenance/reports/backup"

mkdir -p "$REPORT_DIR"
LOG="$REPORT_DIR/$(date '+%Y-%m-%d-%H%M%S')-dgsvr1-${MODE}.log"
ln -sfn "$(basename "$LOG")" "$REPORT_DIR/dgsvr1-latest.log"
exec >>"$LOG" 2>&1
echo "===== $(date '+%Y-%m-%d %H:%M:%S %Z') requested=$MODE server=${SSH_USER}@${SERVER} ====="

mkdir -p /run/lock
exec 9>/run/lock/dgsvr1-backup.lock || exit 1
if ! flock -n 9; then
  echo "A dgsvr1 backup is already running."
  exit 1
fi

if [[ "$(hostname -s)" == "dgsvr1" ]]; then
  echo "Run dgsvr1-backup on the laptop. The Samsung drive stays plugged into the laptop."
  exit 1
fi

DEV=$(blkid -L "$BACKUP_LABEL" || true)
if [[ -z "$DEV" ]]; then
  echo "Drive labeled \"$BACKUP_LABEL\" is not connected to this laptop. Backup skipped."
  exit 1
fi
DEV=$(readlink -f "$DEV")

MOUNTPOINT=$(findmnt -n -o TARGET -S "$DEV" | head -1 || true)
MOUNTED_HERE=0
if [[ -z "$MOUNTPOINT" ]]; then
  mkdir -p "$MNT"
  if ! mount "$DEV" "$MNT"; then
    echo "Could not mount $DEV."
    exit 1
  fi
  MOUNTPOINT="$MNT"
  MOUNTED_HERE=1
fi

if [[ ! -f "$SSH_KEY" || ! -f "$KNOWN_HOSTS" ]]; then
  echo "No backup login yet. On this laptop run: sudo /usr/local/sbin/dgsvr1-backup-setup-ssh"
  exit 1
fi

SSH=(ssh
  -i "$SSH_KEY"
  -o BatchMode=yes
  -o IdentitiesOnly=yes
  -o StrictHostKeyChecking=yes
  -o "UserKnownHostsFile=${KNOWN_HOSTS}"
  -o ConnectTimeout=30
)
RSH=$(printf '%q ' "${SSH[@]}")
RSH="${RSH% }"
REMOTE="${SSH_USER}@${SERVER}"

echo "Checking that the server disks are mounted."
set +e
"${SSH[@]}" "$REMOTE" bash -s <<'EOF'
for mount_path in /boot/efi /data /data2; do
  if ! mountpoint -q "$mount_path"; then
    echo "$mount_path is not mounted on dgsvr1. Backup skipped so an empty folder is not stored as a snapshot."
    exit 2
  fi
done
EOF
SSH_RC=$?
if [[ "$SSH_RC" -eq 2 ]]; then
  exit 1
fi
if [[ "$SSH_RC" -ne 0 ]]; then
  echo "Could not log in to ${REMOTE} (ssh status $SSH_RC)."
  echo "On this laptop run: sudo /usr/local/sbin/dgsvr1-backup-setup-ssh"
  exit 1
fi
set -e

DEST_ROOT="$MOUNTPOINT/$SNAPDIR"
mkdir -p "$DEST_ROOT"

latest_complete() {
  find "$DEST_ROOT" -mindepth 1 -maxdepth 1 -type f -name '.complete-*' -printf '%f\n' 2>/dev/null \
    | sed 's/^\.complete-//' | sort | tail -1
}

STAMP=$(date '+%Y-%m-%d')
RUN_MODE="$MODE"
PREV=""
if [[ "$RUN_MODE" == "incr" ]]; then
  PREV=$(latest_complete || true)
  if [[ -z "$PREV" || ! -d "$DEST_ROOT/$PREV/root" || ! -d "$DEST_ROOT/$PREV/data" || ! -d "$DEST_ROOT/$PREV/data2" ]]; then
    echo "No completed snapshot yet. This run will be a full copy."
    RUN_MODE="full"
    PREV=""
  fi
fi

NAME="${STAMP}-${RUN_MODE}"
if [[ -e "$DEST_ROOT/$NAME" || -e "$DEST_ROOT/.complete-$NAME" ]]; then
  NAME="${STAMP}-${RUN_MODE}-$(date '+%H%M%S')"
fi
DEST="$DEST_ROOT/$NAME"
mkdir -p "$DEST/root" "$DEST/efi" "$DEST/data" "$DEST/data2"

cleanup_fail() {
  echo "Backup failed. Removing incomplete snapshot $NAME."
  rm -rf "$DEST"
  rm -f "$DEST_ROOT/.complete-$NAME"
  if [[ "$MOUNTED_HERE" -eq 1 ]]; then
    umount "$MNT" || true
  fi
}

snapshot_tree() {
  local src="$1" dest="$2" label="$3" link="${4:-}"
  local -a cmd
  if [[ "$label" == "efi" ]]; then
    cmd=(rsync -a --delete --info=stats2 -e "$RSH")
  else
    cmd=(rsync -aAXH --numeric-ids --delete --one-file-system --info=stats2 -e "$RSH")
  fi
  if [[ -n "$link" ]]; then
    cmd+=(--link-dest="$link")
  fi
  if [[ "$label" == "root" ]]; then
    cmd+=(
      --exclude=/lost+found
      --exclude=/swapfile
      --exclude=/swap.img
      --exclude=/tmp/
      --exclude=/var/tmp/
      --exclude=/var/cache/apt/archives/
      --exclude='/home/*/.cache/'
      --exclude='/root/.cache/'
    )
  elif [[ "$label" != "efi" ]]; then
    cmd+=(--exclude=/lost+found)
  fi
  if [[ -n "$link" ]]; then
    echo "Copying $label from ${REMOTE}, reusing unchanged files from $PREV"
  else
    echo "Copying $label from ${REMOTE}"
  fi
  local shell_opts=$-
  set +e
  "${cmd[@]}" "${REMOTE}:${src}" "$dest/"
  local rc=$?
  if [[ "$shell_opts" == *e* ]]; then
    set -e
  fi
  if [[ "$rc" -ne 0 && "$rc" -ne 24 ]]; then
    echo "rsync of $label failed with status $rc."
    return "$rc"
  fi
  return 0
}

link_for() {
  local part="$1"
  if [[ -n "$PREV" && -d "$DEST_ROOT/$PREV/$part" ]]; then
    echo "$DEST_ROOT/$PREV/$part"
  fi
}

if ! snapshot_tree / "$DEST/root" root "$(link_for root)"; then
  cleanup_fail
  exit 1
fi
if ! snapshot_tree /boot/efi/ "$DEST/efi" efi "$(link_for efi)"; then
  cleanup_fail
  exit 1
fi
if ! snapshot_tree /data/ "$DEST/data" data "$(link_for data)"; then
  cleanup_fail
  exit 1
fi
if ! snapshot_tree /data2/ "$DEST/data2" data2 "$(link_for data2)"; then
  cleanup_fail
  exit 1
fi

if [[ ! -d "$DEST/efi/EFI" ]]; then
  echo "The EFI copy has no EFI directory. Snapshot removed."
  cleanup_fail
  exit 1
fi

touch "$DEST_ROOT/.complete-$NAME"
echo "Snapshot ready: $DEST"

if [[ "$MODE" == "full" ]]; then
  echo "Removing snapshots older than $NAME."
  find "$DEST_ROOT" -mindepth 1 -maxdepth 1 \( -type d -o -type f \) \
    ! -name "$NAME" ! -name ".complete-$NAME" -print -exec rm -rf {} +
fi

df -h "$MOUNTPOINT" | tail -1 || true
echo "Finished $(date '+%Y-%m-%d %H:%M:%S %Z')"
exit 0
